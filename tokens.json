{
  "meta": {
    "product": "Personal AI Studio",
    "brandDirection": "warm, technical, focused",
    "designContext": "A dark-first, mobile-capable developer workspace with chat, code editing, preview, and system status surfaces.",
    "signature": {
      "category": "chromatic",
      "move": "one accent, used only on interactive elements, never decorative",
      "reason": "A restrained brass signal color gives controls and active navigation a recognizable point of focus without turning every panel, icon, or status into decoration. Warm-tinted neutrals carry the workspace; semantic status colors remain reserved for status feedback."
    },
    "themeDefault": "dark",
    "tailwindVersion": 4,
    "notes": "Derived from the supplied repository ZIP. GitHub latest-branch parity could not be confirmed during this run."
  },
  "type": {
    "families": {
      "ui": "Plus Jakarta Sans",
      "mono": "JetBrains Mono"
    },
    "fallbacks": [
      {
        "family": "Plus Jakarta Sans",
        "src": "local('Arial'), local('Helvetica Neue'), local('sans-serif')",
        "sizeAdjust": "100%",
        "ascentOverride": "90%",
        "descentOverride": "22%",
        "lineGapOverride": "0%"
      },
      {
        "family": "JetBrains Mono",
        "src": "local('Consolas'), local('Menlo'), local('monospace')",
        "sizeAdjust": "100%",
        "ascentOverride": "90%",
        "descentOverride": "22%",
        "lineGapOverride": "0%"
      }
    ],
    "scale": [
      {
        "name": "type-1",
        "min": "0.75rem",
        "max": "0.8125rem",
        "lineHeight": 1.5
      },
