  "elevation": {
    "mode": "shadow-tiers",
    "borders": {
      "border-1": "1px solid var(--border)"
    },
    "shadows": {
      "shadow-1": "0 1px 2px rgba(8, 10, 7, 0.18)",
      "shadow-2": "0 4px 12px rgba(8, 10, 7, 0.22)",
      "shadow-3": "0 14px 32px rgba(8, 10, 7, 0.28)"
    }
  },
  "motion": {
    "easings": {
      "ease-out": "cubic-bezier(.22,.9,.24,1)",
      "ease-in": "cubic-bezier(.5,0,.75,0)",
      "ease-in-out": "cubic-bezier(.65,0,.35,1)",
      "ease-linear": "linear"
    },
    "durations": {
      "dur-1": "120ms",
      "dur-2": "200ms",
      "dur-3": "320ms",
      "dur-4": "560ms"
    },
    "antiList": [
      "layout properties (width, height, top, left)",
      "filter, backdrop-filter, and box-shadow on repeatedly hovered elements",
      "text color changes on hover; use an opacity or surface treatment instead",
      "anything inside a scroll container already being scrubbed",
      "focus-visible outline and outline-offset; do not animate focus indication"
    ]
  },
